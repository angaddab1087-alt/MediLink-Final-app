# Copy this file to .env and adjust if needed
PORT=4000
DATABASE_URL=postgres://medilink:medilink@localhost:5432/medilink
JWT_SECRET=change-me-to-a-long-random-string
QR_SECRET=change-me-to-another-long-random-string
UPLOAD_DIR=./uploads
CORS_ORIGIN=*
# Lets the app simulate camera scans (prototype "Scan" buttons). Set to false in production.
DEMO_MODE=true
# Requests per minute per client IP (all endpoints) and for login/sign-up/PIN.
RATE_LIMIT_PER_MINUTE=120
# AUTH_RATE_LIMIT_PER_MINUTE=10   (default: 10, or 60 when DEMO_MODE=true)
